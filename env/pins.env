# Every pinned revision for the yue2 stack. Sourced by setup.sh.
#
# Engine revision used by this wrapper.

PY_VERSION=3.13.15

# Our fork of the official inference library (multimodal-art-projection/YuE).
# local-fixes includes the numerical profiles; see the fork log.
YUE_REPO=https://github.com/jeremy-boschen/YuE.git
YUE_COMMIT=b576b126509a76b1eecfd839deb33d77682ceb44

# Runtime version paired with the engine profile and lockfile.
TORCH_VERSION=2.14.0

# Shared model location; installations link to these weights.
MODELS_ROOT=${HOME}/.models/misc/YuE2

# HuggingFace weights, pinned by revision.
HF_YUE2_3B=1a96eca688d6ae5d7f0feb88573fec89920fcd19
HF_YUE2_VAE=95535e72a97bc0f09b8ada125d26b4009428c0e8
