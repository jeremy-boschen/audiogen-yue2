# Every pinned revision for the yue2 stack. Sourced by setup.sh.
#
# This stack does NOT reproduce the ComfyUI album -- different engine, different
# performer. See docs/MATCHING_COMFYUI.md. It reproduces itself, exactly.

PY_VERSION=3.12.14

# Our fork of the official inference library (multimodal-art-projection/YuE).
# local-fixes carries five commits on top of upstream; see the repo's log.
YUE_REPO=https://github.com/jeremy-boschen/YuE.git
YUE_COMMIT=346abe68327311e76257fe59eabd6976783bea06

# torch is the single biggest determinant of what the model writes: six versions
# produced four distinct songs from one seed. It is pinned in the lockfile and
# repeated here because changing it re-rolls every take.
TORCH_VERSION=2.10.0

# HuggingFace weights, pinned by revision.
HF_YUE2_3B=1a96eca688d6ae5d7f0feb88573fec89920fcd19
HF_YUE2_VAE=95535e72a97bc0f09b8ada125d26b4009428c0e8
