# Everything setup.sh builds
.venv/
.venv-*/
/models/
__pycache__/
*.py[cod]
*.egg-info/

# Rendered audio -- regenerate it; back it up separately.
# Canary reference audio is committed on purpose (see songs/_canary), so an
# environment failure can be diagnosed and not merely detected.
*.flac
!songs/_canary/reference/*.flac
*.mp3
*.wav
*.aiff
*.aif
*.m4a
*.ogg
*.opus

# Model weights / large binaries
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx

# Generated artifacts. A fixture's reference arrays are the exception: semantic.npy
# and latent.npy are how a take travels between machines, and they are small.
# Rendered audio is NOT committed -- the per-stage hashes localise a regression
# better than a waveform can, and semantic.npy re-derives the audio exactly.
*.npy
!songs/*/reference/*.npy

# Local scratch
/out/
/runs/
*.log
*.bak
*.partial
.DS_Store
.idea/
.vscode/

# Working convenience links into the wrapper's album directory. They are
# absolute paths on one machine, so committing one puts a dead link in the
# repo for everyone else.
songs/cheap_arcade
